APP_NAME="Audio Speed Converter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=audio_converter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Audio upload (Tahap 5)
AUDIO_DISK=audio
AUDIO_MAX_UPLOAD_MB=100

# FFmpeg (Tahap 7) — absolute paths, queue worker tidak bergantung pada PATH
FFMPEG_PATH=C:/laragon/bin/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=C:/laragon/bin/ffmpeg/bin/ffprobe.exe
AUDIO_PROCESS_TIMEOUT=600
AUDIO_PROGRESS_STEP=5

# Queue (Tahap 8)
QUEUE_CONNECTION=database
AUDIO_QUEUE=audio-conversions
AUDIO_QUEUE_TIMEOUT=600
AUDIO_QUEUE_TRIES=3

# Speed (Tahap 6) — range aman & configurable
AUDIO_SPEED_MIN=0.5
AUDIO_SPEED_MAX=4

# Retention & recovery (Tahap 13)
AUDIO_RETENTION_HOURS=24
AUDIO_STUCK_AFTER_MINUTES=30

# Worker & rate limit (Tahap 8 / 13 / 14)
AUDIO_MAX_WORKERS=2
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CONVERSION=20
RATE_LIMIT_STATUS=240
RATE_LIMIT_DOWNLOAD=60
